{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Laravel API",
      "type": "shell",
      "command": "php",
      "args": [
        "artisan",
        "serve",
        "--host=127.0.0.1",
        "--port=8046"
      ],
      "options": {
        "cwd": "${workspaceFolder}/enrollment_validator_api"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Flutter Web",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run",
        "-d",
        "chrome",
        "--web-port=5046",
        "--dart-define=API_BASE_URL=http://127.0.0.1:8046/api"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build local web (bundled resources)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "Build-Local-Web.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Serve built local web",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/serve-web.cjs"
      ],
      "problemMatcher": []
    }
  ]
}
